<UserControl x:Class="PluginLoader.PluginController"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Common.Controls;assembly=Common.Controls"
             xmlns:conv="clr-namespace:Common.Converter;assembly=Common.Converter"
             xmlns:pluginloader="clr-namespace:PluginLoader"
             Height="450"
             Width="800">

    <UserControl.Resources>
        <!-- Enum to Boolean Converter -->
        <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0" Grid.ColumnSpan="3">
            <MenuItem Header="_Plugins">
                <MenuItem Header="_Load Plugins..." 
                  Command="{Binding LoadPluginsCommand}" 
                  InputGestureText="Ctrl+L" />

                <MenuItem Header="_Clear Plugins" 
                  Command="{Binding ClearPluginsCommand}" 
                  InputGestureText="Ctrl+Shift+C" />

                <Separator />
                
                <!-- Preferred context selection -->
                <MenuItem Header="Preferred _Context">

                    <MenuItem Header="Managed"
                              IsCheckable="True"
                              Command="{Binding SetPreferredContextCommand}"
                              CommandParameter="Managed"
                              IsChecked="{Binding PreferredContext,
                                  Converter={StaticResource EnumToBooleanConverter},
                                  ConverterParameter=Managed}" />

                    <MenuItem Header="ManagedCom"
                              IsCheckable="True"
                              Command="{Binding SetPreferredContextCommand}"
                              CommandParameter="ManagedCom"
                              IsChecked="{Binding PreferredContext,
                                  Converter={StaticResource EnumToBooleanConverter},
                                  ConverterParameter=ManagedCom}" />

                    <MenuItem Header="Unmanaged"
                              IsCheckable="True"
                              Command="{Binding SetPreferredContextCommand}"
                              CommandParameter="Unmanaged"
                              IsChecked="{Binding PreferredContext,
                                  Converter={StaticResource EnumToBooleanConverter},
                                  ConverterParameter=Unmanaged}" />

                </MenuItem>

                <Separator />

                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>

            <MenuItem Header="_Settings">
                <!-- Set plugin folder path -->
                <MenuItem Header="_Plugin Path..." />
                <!--Command="{Binding SetPluginPathCommand}" />-->
            </MenuItem>
        </Menu>

        <!-- Plugins -->
        <DataGrid Grid.Column="0"
                  ItemsSource="{Binding Plugins}"
                  SelectedItem="{Binding SelectedPlugin}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True" Grid.ColumnSpan="2" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Symbols -->
        <ListBox Grid.Column="1"
                 ItemsSource="{Binding Symbols}"
                 SelectedItem="{Binding SelectedSymbol}" Grid.Row="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Definition.Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Inspector / Method -->
        <ContentControl Grid.Column="2"
                        Content="{Binding SelectedSymbol}" Grid.Row="1">

            <ContentControl.Resources>

                <DataTemplate x:Key="DataSymbolTemplate">
                    <local:InspectorGrid SelectedObject="{Binding}" />
                </DataTemplate>

                <DataTemplate x:Key="MethodSymbolTemplate">
                    <Grid>
                        <Button Content="Execute"
                                Command="{Binding ExecuteCommand}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Padding="16,6"
                                MinWidth="100"
                                Height="32"
                                Margin="8" />
                    </Grid>
                </DataTemplate>


                <pluginloader:SymbolTemplateSelector
                    x:Key="SymbolSelector"
                    DataTemplate="{StaticResource DataSymbolTemplate}"
                    MethodTemplate="{StaticResource MethodSymbolTemplate}" />

            </ContentControl.Resources>

            <ContentControl.ContentTemplateSelector>
                <StaticResource ResourceKey="SymbolSelector" />
            </ContentControl.ContentTemplateSelector>

        </ContentControl>

        <TextBox Text="{Binding PluginMessages}"
                 IsReadOnly="True"
                 AcceptsReturn="True" Grid.ColumnSpan="3" Grid.Column="0" Grid.Row="2" />

    </Grid>
</UserControl>